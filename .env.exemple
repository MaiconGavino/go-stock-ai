# Copie este arquivo para .env (ou exporte as variáveis no seu shell) e
# preencha com seus próprios valores. Nunca commite a chave real.

# Obrigatória para o comando web (cmd/web) e opcionalmente usada pelo MCP
# se você evoluir o projeto para chamar a IA também por ali.
OPENAI_API_KEY=

# Opcional. Se omitida, usa o padrão definido em internal/ai/client.go
# (DefaultModel = "gpt-4o-mini"). Precisa ser um modelo com suporte a
# tool calling na Responses API.
OPENAI_MODEL=gpt-4o-mini

# Opcional. Porta HTTP do comando web (cmd/web). Padrão: 8080.
PORT=8080

# Opcional. Diretório dos arquivos estáticos da interface web. Padrão: web.
WEB_DIR=web